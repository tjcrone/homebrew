#!/usr/bin/env ruby
# frozen_string_literal: true

CUSTOM_CASKS = {
  "codex" => "tjcrone/homebrew/codex",
  "claude-code" => "tjcrone/homebrew/claude-code",
}.freeze

def fail_upgrade(message)
  warn "brew-upgrade: #{message}"
  exit 1
end

def qualify_custom_casks(arguments)
  return arguments if arguments.include?("--formula")

  arguments.map { |argument| CUSTOM_CASKS.fetch(argument, argument) }
end

def run!(*command)
  return if system(*command)

  status = $?&.exitstatus
  fail_upgrade("#{command.join(' ')} failed#{status ? " with status #{status}" : nil}")
end

def executable_on_path(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |directory|
    candidate = File.join(directory, name)
    return candidate if File.file?(candidate) && File.executable?(candidate)
  end
  nil
end

brew = executable_on_path("brew")
fail_upgrade("could not find the Homebrew executable on PATH") unless brew

run!(brew, "update")
exec(brew, "upgrade", *qualify_custom_casks(ARGV))
